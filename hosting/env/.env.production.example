# Production environment — copy to `.env.production` on your VPS and fill in values.
# Never commit the real `.env.production` file.

# ── Domains (HTTPS) ──────────────────────────────────────────────
APP_URL=https://battleasia.net
CORS_ORIGINS=https://battleasia.net,https://www.battleasia.net,https://shop.battleasia.net,https://admin.battleasia.net

# ── MongoDB Atlas ────────────────────────────────────────────────
# Create cluster at https://cloud.mongodb.com
# Network Access: allow your VPS IP (or 0.0.0.0/0 during setup)
# Database Access: create user with readWrite on `battleasia`
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/battleasia?retryWrites=true&w=majority

# ── API secrets (generate strong random values) ──────────────────
JWT_SECRET=replace-with-64-char-random-string
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=replace-with-strong-password
ADMIN_USERNAME=admin
NODE_ENV=production
PORT=5050

# ── CDN (Cloudflare / Bunny / S3+CloudFront) ─────────────────────
# Upload FE/Shop `dist/assets/` to CDN bucket, then set origin URL:
CDN_URL=https://cdn.battleasia.net
VITE_CDN_URL=https://cdn.battleasia.net
VITE_SERVER_URL=
VITE_BAC_SHOP_URL=https://shop.battleasia.net/user/shop
REACT_APP_API_URL=

# ── SSL / Certbot (see deploy/init-ssl.sh) ───────────────────────
SSL_EMAIL=admin@yourdomain.com
SSL_DOMAINS=battleasia.net,www.battleasia.net,shop.battleasia.net,admin.battleasia.net

# ── Optional ─────────────────────────────────────────────────────
COINGO_MOCK=false
LOG_AUTH_CODES=false
SYNC_ADMIN_PASSWORD=false
