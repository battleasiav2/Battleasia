# nixbazar.com — single domain production env
# Copy to hosting/api/.env on server

APP_URL=https://nixbazar.com
CORS_ORIGINS=https://nixbazar.com,https://www.nixbazar.com

MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/battleasia?retryWrites=true&w=majority

JWT_SECRET=replace-with-64-char-random-string
ADMIN_EMAIL=admin@nixbazar.com
ADMIN_PASSWORD=replace-with-strong-password
ADMIN_USERNAME=admin
NODE_ENV=production
PORT=5050

# Same-origin API — frontends use relative /api when VITE_SERVER_URL is empty
VITE_SERVER_URL=
VITE_BAC_SHOP_URL=https://nixbazar.com/store/user/shop
REACT_APP_API_URL=https://nixbazar.com
REACT_APP_BASENAME=/admin

COINGO_MOCK=false
LOG_AUTH_CODES=false
