# Copy to .env (gitignored) before compose.
# Local:  docker compose -f docker-compose.mongo.yml up -d
# Full:   docker compose up -d --build
# VPS:    docker compose -f docker-compose.prod.yml up -d --build
# Coolify: docker-compose.coolify.yml + these same keys in the UI

API_PATH=../../battleasianew/api

JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@battleasia.gg
ADMIN_PASSWORD=change-me-strong-password
ADMIN_USERNAME=admin

# Local CORS is already set in docker-compose.yml
# CORS_ORIGINS=https://battleasia.gg,https://www.battleasia.gg,https://shop.battleasia.gg,https://admin.battleasia.gg
# APP_URL=https://battleasia.gg
# MONGODB_URI=mongodb://mongo:27017/battleasia?replicaSet=rs0

# Baked into frontend images at build time — rebuild after changing:
VITE_BAC_SHOP_URL=http://localhost:8083
VITE_MAIN_APP_URL=http://localhost:8088
VITE_PLAYER_URL=http://localhost:8088
# VITE_SENTRY_DSN=
# VITE_FIREBASE_VAPID_KEY=

# API live mail (Admin → System → Mail, or set here as fallback)
# Hostinger example — same as live api/.env.example
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=no-reply@battleasia.gg
# SMTP_PASS=your-mailbox-password
# MAIL_FROM=no-reply@battleasia.gg
# MAIL_FROM_NAME=BattleAsia
# LOG_AUTH_CODES=true

# Observability / push / off-site backup
# SENTRY_DSN=
# FCM_SERVER_KEY=
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=
# BACKUP_S3_BUCKET=
# BACKUP_S3_REGION=
# BACKUP_OFFSITE_CMD=

# Production nginx (docker-compose.prod.yml):
# NGINX_CONFIG=prod.bootstrap.conf
# After Let's Encrypt: NGINX_CONFIG=prod.conf
