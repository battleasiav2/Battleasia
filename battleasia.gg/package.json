{
  "name": "battleasia.gg",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "optimize:assets": "node scripts/optimize-assets.mjs",
    "make:hero": "node scripts/make-hero-video.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview",
    "lh": "npx --yes lighthouse http://127.0.0.1:4180/dashboard --only-categories=performance --form-factor=mobile --screenEmulation.mobile --chrome-flags=\"--headless=new --allow-insecure-localhost\" --quiet --output=json --output-path=./lighthouse-landing.json"
  },
  "dependencies": {
    "@sentry/browser": "^10.75.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "sharp": "^0.35.4",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
