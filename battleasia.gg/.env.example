VITE_PORT=8081
VITE_SERVER_URL=http://localhost:5050
# Local separate ports: http://localhost:8082/user/shop
# Single-domain proxy (localhost:8080): /store/user/shop
VITE_BAC_SHOP_URL=http://localhost:8082/user/shop

# Production build (battleasia.gg) — same-origin API:
# VITE_SERVER_URL=
# VITE_BAC_SHOP_URL=https://battleasia.gg/store/user/shop
# Optional CDN: VITE_CDN_URL=https://cdn.battleasia.gg

# Home "About" headline figures — override without touching code.
# Defaults (if unset): 500K+, $2M+, 15+, 24/7
# VITE_STAT_ACTIVE_PLAYERS=500K+
# VITE_STAT_PRIZE_MONEY=$2M+
# VITE_STAT_GAMES_SUPPORTED=15+
# VITE_STAT_TOURNAMENTS=24/7
