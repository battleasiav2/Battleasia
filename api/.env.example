PORT=5050
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/battleasia
JWT_SECRET=change-me-in-production-use-long-random-string
ADMIN_EMAIL=admin@battleasia.local
ADMIN_PASSWORD=Admin@123456
ADMIN_USERNAME=admin

# Only set to true in local dev when you want .env password to overwrite existing admin
SYNC_ADMIN_PASSWORD=false

# Comma-separated allowed browser origins (defaults include localhost + battleasia.local)
# Single domain production:
# CORS_ORIGINS=https://battleasia.gg,https://www.battleasia.gg

# Local dev only — mock Coingo payment success after polling
COINGO_MOCK=false

# Local dev only — print OTP/verification codes to console
LOG_AUTH_CODES=false

# Set to false to skip admin login OTP (local dev only; keep enabled in production)
# ADMIN_LOGIN_OTP=false

# Production only
# APP_URL=https://battleasia.net
# CDN_URL=https://cdn.battleasia.net
