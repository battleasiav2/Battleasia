PORT=5050
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/battleasia
JWT_SECRET=change-me-in-production-use-long-random-string
ADMIN_EMAIL=admin@battleasia.local
ADMIN_PASSWORD=Admin@123456
ADMIN_USERNAME=admin

# Only set to true in local dev when you want .env password to overwrite existing admin
SYNC_ADMIN_PASSWORD=false

# Comma-separated allowed browser origins (defaults include localhost + battleasia.local)
# Single domain production:
# CORS_ORIGINS=https://battleasia.gg,https://www.battleasia.gg

# Local dev only — mock Coingo payment success after polling
COINGO_MOCK=false

# Local dev only — print OTP/verification codes to console
LOG_AUTH_CODES=false

# Second factor for admin login. Off by default — only turn on once SMTP works,
# otherwise the code is never delivered and nobody can reach the panel.
# ADMIN_LOGIN_OTP=true

# SMTP for player sign-up / password reset codes. Used only when Mail settings
# are not filled in from the admin panel (Admin > Settings > Mail).
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=no-reply@battleasia.gg
# SMTP_PASS=your-mailbox-password
# MAIL_FROM=no-reply@battleasia.gg
# MAIL_FROM_NAME=BattleAsia

# Production only (single domain)
# APP_URL=https://battleasia.gg
# CDN_URL=https://cdn.battleasia.gg
# CORS_ORIGINS=https://battleasia.gg,https://www.battleasia.gg,https://shop.battleasia.gg,https://admin.battleasia.gg

# Observability / push (fail-open if empty)
# SENTRY_DSN=https://public@o0.ingest.sentry.io/0
# FCM_SERVER_KEY=

# Encrypted off-site dumps (S3 / R2 / B2 compatible)
# BACKUP_ENCRYPT_PASSPHRASE=
# BACKUP_S3_ENDPOINT=https://ACCOUNT.r2.cloudflarestorage.com
# BACKUP_S3_BUCKET=battleasia-backups
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET=
# BACKUP_S3_REGION=auto
# BACKUP_OFFSITE_CMD=rclone copy {file} remote:battleasia-backups

