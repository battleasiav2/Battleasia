# Production multi-stage build for Player FE
FROM node:20-alpine AS build
WORKDIR /app
COPY battleasia-fe-main/battleasia-fe-main/package.json battleasia-fe-main/battleasia-fe-main/package-lock.json ./
RUN npm ci
COPY battleasia-fe-main/battleasia-fe-main/ .
ARG VITE_SERVER_URL=
ARG VITE_CDN_URL=
ARG VITE_BAC_SHOP_URL=
ENV VITE_SERVER_URL=$VITE_SERVER_URL
ENV VITE_CDN_URL=$VITE_CDN_URL
ENV VITE_BAC_SHOP_URL=$VITE_BAC_SHOP_URL
RUN npm run build

FROM nginx:1.27-alpine
COPY docker/nginx/fe.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
