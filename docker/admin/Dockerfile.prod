# Production multi-stage build for Admin
FROM node:20-alpine AS build
WORKDIR /app
COPY admin.battleasia.gg/package.json admin.battleasia.gg/package-lock.json ./
RUN npm ci --legacy-peer-deps
COPY admin.battleasia.gg/ .
ARG REACT_APP_API_URL=
ARG REACT_APP_BASENAME=
ARG PUBLIC_URL=
ENV REACT_APP_API_URL=$REACT_APP_API_URL
ENV REACT_APP_BASENAME=$REACT_APP_BASENAME
ENV PUBLIC_URL=$PUBLIC_URL
RUN npm run build

FROM nginx:1.27-alpine
COPY docker/nginx/admin.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/build /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
