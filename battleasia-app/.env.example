# =============================================================================
# BattleAsia Flutter — .env setup (Android Studio / APK build)
# =============================================================================
#
# 1. Copy one profile to .env (app loads ONLY .env at build time):
#
#    Emulator (Android Studio Run on AVD):
#      copy .env.emulator .env
#
#    Real phone + local API on PC (same Wi‑Fi):
#      copy .env.device .env
#      (edit .env.device if your PC IP is not 192.168.0.105)
#
#    Release APK (live production):
#      copy .env.production .env
#
# 2. Start local API (if using emulator/device profile):
#      cd ..\api
#      npm run dev
#
# 3. Android Studio:
#      Open folder: battleasia-app
#      Run ▶ (debug) or Build → Flutter → Build APK
#
# 4. After changing .env you MUST rebuild (hot reload does not refresh .env):
#      flutter clean && flutter pub get && flutter run
#      — or — Build → Clean Project, then build APK again
#
# =============================================================================

# --- emulator (default in .env) ---
API_BASE_URL=http://10.0.2.2:5050
SITE_URL=https://battleasia.gg

# --- real phone + local API (see .env.device) ---
# API_BASE_URL=http://192.168.0.105:5050

# --- production APK (see .env.production) ---
# API_BASE_URL=https://battleasia.gg
