# ── Single domain (battleasia.gg) ────────────────────────────────
APP_URL=https://battleasia.gg
CORS_ORIGINS=https://battleasia.gg,https://www.battleasia.gg

# ── MongoDB (Hostinger or Atlas) ─────────────────────────────────
MONGODB_URI=mongodb://USER:PASSWORD@HOST:27017/battleasia?authSource=admin

# ── API secrets ──────────────────────────────────────────────────
JWT_SECRET=replace-with-64-char-random-string
ADMIN_EMAIL=admin@battleasia.gg
ADMIN_PASSWORD=replace-with-strong-password
ADMIN_USERNAME=admin
NODE_ENV=production
PORT=5050

# ── Frontend build (npm run build) ───────────────────────────────
# Same-origin API — leave VITE_SERVER_URL empty
VITE_SERVER_URL=
VITE_BAC_SHOP_URL=https://battleasia.gg/store/user/shop
VITE_MAIN_APP_URL=https://battleasia.gg
VITE_BASE_PATH=/store/
VITE_CDN_URL=
REACT_APP_API_URL=https://battleasia.gg
REACT_APP_BASENAME=/admin
PUBLIC_URL=/admin

# ── Optional ─────────────────────────────────────────────────────
COINGO_MOCK=false
LOG_AUTH_CODES=false
SYNC_ADMIN_PASSWORD=false
